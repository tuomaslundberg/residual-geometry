#!/bin/bash
#SBATCH --job-name=reg-geo-baseline
#SBATCH --account=project_462000999
#SBATCH --partition=small-g
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=experiments/slurm/logs/%x_%j.out
#SBATCH --error=experiments/slurm/logs/%x_%j.err

# If invoked directly (not via sbatch), archive previous logs and submit.
if [ -z "$SLURM_JOB_ID" ]; then
    LOGDIR="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)/experiments/slurm/logs"
    mkdir -p "$LOGDIR/archive"
    # Move any existing .out/.err into archive before this run
    find "$LOGDIR" -maxdepth 1 \( -name "*.out" -o -name "*.err" \) -exec mv {} "$LOGDIR/archive/" \;
    sbatch "$0" "$@"
    exit
fi

set -euo pipefail

REPO=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$REPO"

JOB_START=$(date +%s)
echo "Job $SLURM_JOB_ID started at $(date -Is)"
echo "Node: $SLURMD_NODENAME  REPO: $REPO"

# --- Module loading ---
# LUMI uses a hierarchical EasyBuild module system.
# LUMI/<version> sets the software stack; partition/G unlocks GPU-compiled modules.
# The PyTorch module on LUMI is a Singularity container — not a native Python env.
#
# Before first use, check available versions:
#   module spider PyTorch
#
# PyTorch 2.6.0+ containers manage a pip-installable venv automatically
# ($CONTAINERROOT/user-software/venv/pytorch). Prefer this if available.
#
# PyTorch 2.2.2 (current): uses miniconda inside the container.
# Extra packages must be installed via PYTHONUSERBASE (see below).
# Python invocation via: singularity exec $SIF conda-python-simple <script>
module purge
module load LUMI/24.03 partition/G
module load PyTorch/2.2.2-rocm-5.6.1-python-3.10-singularity-20240315

# --- Python package path ---
# venvs on LUMI's Lustre filesystem do not work cleanly with the singularity
# container. Workaround: point PYTHONUSERBASE to a scratch path that is
# bind-mounted into the container by $SINGULARITY_BIND.
# Install once interactively: pip install --user -e ".[dev]"
export PYTHONUSERBASE=/scratch/project_462000999/tlundber/pythonuserbase

# --- Run ---
CONFIG=experiments/configs/exp_baseline.yaml
singularity exec "$SIF" conda-python-simple scripts/run_pipeline.py \
    --config "$CONFIG"

# --- Timing ---
echo "Job $SLURM_JOB_ID finished at $(date -Is)"
echo "Elapsed: $(( $(date +%s) - JOB_START ))s"
