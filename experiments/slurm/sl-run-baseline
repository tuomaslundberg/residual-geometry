#!/bin/bash
#SBATCH --job-name=reg-geo-baseline
#SBATCH --account=project_462000999
#SBATCH --partition=small-g
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=experiments/slurm/logs/%x_%j.out
#SBATCH --error=experiments/slurm/logs/%x_%j.err

# If invoked directly (not via sbatch), archive previous logs and submit.
if [ -z "$SLURM_JOB_ID" ]; then
    LOGDIR="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)/experiments/slurm/logs"
    mkdir -p "$LOGDIR/archive"
    find "$LOGDIR" -maxdepth 1 \( -name "*.out" -o -name "*.err" \) -exec mv {} "$LOGDIR/archive/" \;
    sbatch "$0" "$@"
    exit
fi

set -euo pipefail

REPO=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$REPO"

JOB_START=$(date +%s)
echo "Job $SLURM_JOB_ID started at $(date -Is)"
echo "Node: $SLURMD_NODENAME  REPO: $REPO"

# --- Module loading ---
# Use the CSC pytorch module stack — NOT the LUMI/24.03 EasyBuild stack,
# which is explicitly unsupported (ROCm/GPU driver mismatch as of 2026-04).
#
# pytorch/2.7 is a Singularity container, but the module sets up transparent
# wrappers: 'python', 'python3', and 'pip3' all call into the container.
# No 'singularity exec' invocation needed.
#
# Python version inside the container: 3.11.0rc1 (CSC-shipped RC build).
#
# Note: SLURM jobs do NOT go through the SSH RemoteCommand that pre-loads
# this module in interactive sessions. Must load it explicitly here.
module purge
module use /appl/local/csc/modulefiles
module load pytorch/2.7

# --- Package path ---
# Packages installed to PYTHONUSERBASE on /scratch are visible inside the
# container (the container mounts /scratch). This is the working workaround
# for adding packages on top of the CSC module without a venv.
# Install once interactively: python -m pip install --user -e ".[dev]"
# Do NOT use 'pip3' directly — it resolves to /usr/bin/pip3 (system Python 3.6)
# rather than the container wrapper. 'python' is correctly the container binary.
export PYTHONUSERBASE=/scratch/project_462000999/tlundber/pythonuserbase

# --- Run ---
python scripts/run_pipeline.py --config experiments/configs/exp_baseline.yaml

# --- Timing ---
echo "Job $SLURM_JOB_ID finished at $(date -Is)"
echo "Elapsed: $(( $(date +%s) - JOB_START ))s"
