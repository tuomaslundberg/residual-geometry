#!/bin/bash
#SBATCH --job-name=residual-geo-phase2
#SBATCH --partition=small-g
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=experiments/slurm/logs/%x_%j.out
#SBATCH --error=experiments/slurm/logs/%x_%j.err
source ~/lumi-env.sh

# If invoked directly (not via sbatch), archive previous logs and submit.
if [ -z "$SLURM_JOB_ID" ]; then
    LOGDIR="$(git -C "$(pwd)" rev-parse --show-toplevel)/experiments/slurm/logs"
    mkdir -p "$LOGDIR/archive"
    find "$LOGDIR" -maxdepth 1 \( -name "*.out" -o -name "*.err" \) -exec mv {} "$LOGDIR/archive/" \;
    sbatch "$0" "$@"
    exit
fi

set -euo pipefail

REPO=$(git -C "$SLURM_SUBMIT_DIR" rev-parse --show-toplevel)
cd "$REPO"

JOB_START=$(date +%s)
echo "Job $SLURM_JOB_ID started at $(date -Is)"
echo "Node: $SLURMD_NODENAME  REPO: $REPO"

module purge
module use /appl/local/csc/modulefiles
module load pytorch/2.7

export PYTHONUSERBASE=$WORK/pythonuserbase
export PYTHONPATH="$REPO/src:${PYTHONPATH:-}"

FI=$WORK/data/hplt-samples/v3/fin_Latn_sample_exploded.jsonl
EN=$WORK/data/hplt-samples/v3/eng_Latn_sample_exploded.jsonl

# --- Run ---
python3 experiments/pilot_phase2.py \
    --fi "$FI" \
    --en "$EN" \
    --out outputs/pilot_phase2.json \
    --n-docs 5000 \
    --min-confidence 0.4

# --- Timing ---
echo "Job $SLURM_JOB_ID finished at $(date -Is)"
echo "Elapsed: $(( $(date +%s) - JOB_START ))s"
