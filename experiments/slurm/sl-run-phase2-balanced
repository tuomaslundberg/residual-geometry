#!/bin/bash
#SBATCH --job-name=residual-geo-phase2-bal
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=03:00:00
#SBATCH --array=0-39
#SBATCH --output=experiments/slurm/logs/%x_%A_%a.out
#SBATCH --error=experiments/slurm/logs/%x_%A_%a.err
source ~/lumi-env.sh

# Class-balanced Phase 2 pilot: 20 seeded draws x 2 register rules, MT dropped, LY left out.
# Tasks 0-19: top register (argmax) per document; tasks 20-39: single-register documents only.
# Embeddings come from the cache (fill it first with sl-run-embed), so no GPU is needed.
# PER_CLASS= overrides the per-register sample size (default 385 = Finnish SP, single-register).

# If invoked directly (not via sbatch), archive previous logs and submit.
if [ -z "$SLURM_JOB_ID" ]; then
    LOGDIR="$(git -C "$(pwd)" rev-parse --show-toplevel)/experiments/slurm/logs"
    mkdir -p "$LOGDIR/archive"
    find "$LOGDIR" -maxdepth 1 \( -name "*.out" -o -name "*.err" \) -exec mv {} "$LOGDIR/archive/" \;
    sbatch "$0" "$@"
    exit
fi

set -euo pipefail

REPO=$(git -C "$SLURM_SUBMIT_DIR" rev-parse --show-toplevel)
cd "$REPO"

JOB_START=$(date +%s)
echo "Job $SLURM_JOB_ID (task $SLURM_ARRAY_TASK_ID) started at $(date -Is)"

module purge
module use /appl/local/csc/modulefiles
module load pytorch/2.7

export PYTHONUSERBASE=$WORK/pythonuserbase
export PYTHONPATH="$REPO/src:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1

FI=$WORK/data/hplt-samples/v3/fin_Latn_sample_exploded.jsonl
EN=$WORK/data/hplt-samples/v3/eng_Latn_sample_exploded.jsonl

SEED=$(( SLURM_ARRAY_TASK_ID % 20 ))
if [ "$SLURM_ARRAY_TASK_ID" -lt 20 ]; then RULE=argmax; RULE_ARGS=(); else RULE=single; RULE_ARGS=(--single-register); fi
OUT=outputs/phase2_balanced/$RULE/draw_$(printf %02d "$SEED").json

python3 experiments/pilot_phase2.py \
    --fi "$FI" \
    --en "$EN" \
    --out "$OUT" \
    --min-confidence 0.4 \
    --exclude-mt \
    "${RULE_ARGS[@]}" \
    --exclude-registers LY \
    --per-class "${PER_CLASS:-385}" \
    --draw-seed "$SEED"

echo "Job $SLURM_JOB_ID (task $SLURM_ARRAY_TASK_ID) finished at $(date -Is)"
echo "Elapsed: $(( $(date +%s) - JOB_START ))s"
