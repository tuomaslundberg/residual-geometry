#!/bin/bash
#SBATCH --job-name=thesis-filter-en
#SBATCH --partition=small
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=06:00:00
#SBATCH --output=experiments/slurm/logs/%x_%j.out
#SBATCH --error=experiments/slurm/logs/%x_%j.err
# English part of the thesis sample (scripts/thesis_sample.py): a proportional random
# sample of HPLT 4 English WDS 9-10 = the whole published level-9 pool (2.3M of
# 1,124M level-9 documents) + the first 26,360 documents of the shuffled level-10 pool
# (12.9M = all of level 10), i.e. 2.3M x 12.886/1124.3. Streams from LUMI-O.
set -euo pipefail
source ~/lumi-env.sh
module use /appl/local/csc/modulefiles; module load pytorch/2.7; module load lumio
OUTD=$WORK/data/thesis-sample-v4/en; mkdir -p "$OUTD"
SRC=lumi-462001491-private:hplt-samples/v4/eng_Latn
rclone cat $SRC/9-n2300000-s20261016/samples.jsonl.zst | zstdcat \
  | python3 scripts/thesis_sample.py filter --lang eng --source eng-L9-n2300000-s20261016 --out "$OUTD/eligible-L9.jsonl" \
  2> "$OUTD/counts-L9.json"
set +o pipefail  # head closes the stream early on purpose
rclone cat $SRC/10-n12886073-s20261016/samples.jsonl.zst | zstdcat | head -n 26360 \
  | python3 scripts/thesis_sample.py filter --lang eng --source eng-L10-prefix26360-s20261016 --out "$OUTD/eligible-L10.jsonl" \
  2> "$OUTD/counts-L10.json"
echo done
